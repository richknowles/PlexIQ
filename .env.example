# PlexIQ Configuration Template
# Copy this file to .env and fill in your values

# Plex Configuration
PLEX_URL=http://localhost:32400
PLEX_TOKEN=your_plex_token_here

# External API Keys
TMDB_API_KEY=your_tmdb_api_key_here
OMDB_API_KEY=your_omdb_api_key_here

# Scoring Weights (must sum to ~1.0)
WEIGHT_PLAY_COUNT=0.3
WEIGHT_RATINGS=0.25
WEIGHT_SIZE=0.2
WEIGHT_AGE=0.15
WEIGHT_QUALITY=0.1

# Deletion Thresholds
MIN_DELETION_SCORE=0.7
NEVER_DELETE_RATING_THRESHOLD=8.0

# Application Settings
LOG_LEVEL=INFO
DRY_RUN_DEFAULT=false
LOG_RETENTION_DAYS=30
BACKUP_RETENTION_DAYS=7

# Data Directories
DATA_DIR=./data
BACKUP_DIR=./data/backups
LOG_DIR=./data/logs
CACHE_DIR=./data/cache

# Security Settings
# SHA-256 hash of deletion password (generate with: echo -n "password" | sha256sum)
DELETION_PASSWORD_HASH=